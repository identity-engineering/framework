---
import Layout from '../layouts/Layout.astro';
import ConceptSceneMount from '../components/concepts/ConceptSceneMount.astro';
import { concepts } from '../lib/concepts';
import { biologyByLayer } from '../lib/biologyConcepts';

/**
 * Official structure:
 * Same three scales under two science lenses (Physics · Biology),
 * plus Living Identity as operational scaffold.
 */

const single = concepts.filter((c) => c.layer === 'single');
const interactive = concepts.filter((c) => c.layer === 'interactive');
const collective = concepts.filter((c) => c.layer === 'collective');

const bioSingle = biologyByLayer('single');
const bioInteractive = biologyByLayer('interactive');
const bioCollective = biologyByLayer('collective');
---

<Layout title="Framework | Identity Engineering">
	<main>
		<section class="min-h-[55vh] flex flex-col justify-center pt-28 pb-16">
			<div class="max-w-4xl mx-auto px-8">
				<div class="text-sm uppercase tracking-[4px] text-white/40 mb-6">The Framework</div>
				<h1 class="text-5xl md:text-7xl font-bold tracking-tighter leading-[0.95] mb-8 text-white">
					Identity Engineering
				</h1>
				<p class="text-xl md:text-2xl text-white/50 font-light max-w-2xl leading-relaxed">
					A science-inspired framework for consciously designing identity in the AI era.
					Three scales — Single, Interactive, Collective — under two lenses: physics geometry and living form.
				</p>
				<div class="mt-6 rounded-2xl border border-white/10 bg-white/[0.03] p-4 max-w-2xl">
					<p class="text-sm text-white/60 leading-relaxed">
						This framework serves systems-thinking individuals and teams with enough decision latitude to make consequential identity choices.
						It is not a universal model for every life context. Analogy, not isomorphism.
					</p>
				</div>

				{/* Lens switcher */}
				<div class="mt-10 flex flex-wrap items-center gap-3" id="lens-switcher" role="tablist" aria-label="Science lens">
					<span class="text-sm uppercase tracking-[3px] text-white/35 mr-2">Lens</span>
					<button
						type="button"
						role="tab"
						id="lens-physics"
						aria-selected="true"
						aria-controls="lens-panel-physics"
						data-lens="physics"
						class="lens-btn px-5 py-2.5 rounded-full text-sm font-medium transition bg-white text-black"
					>
						Physics
					</button>
					<button
						type="button"
						role="tab"
						id="lens-biology"
						aria-selected="false"
						aria-controls="lens-panel-biology"
						data-lens="biology"
						class="lens-btn px-5 py-2.5 rounded-full text-sm font-medium transition border border-white/20 text-white/70 hover:bg-white/5"
					>
						Biology
					</button>
				</div>
			</div>
		</section>

		{/* ========== PHYSICS LENS ========== */}
		<div id="lens-panel-physics" role="tabpanel" aria-labelledby="lens-physics" aria-hidden="false" tabindex="0" data-lens-panel="physics">
			<section id="single" class="border-t border-white/10">
				<div class="max-w-6xl mx-auto px-8 pt-20 pb-8">
					<div class="text-sm uppercase tracking-[4px] text-white/40 mb-3">01 · Physics</div>
					<h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white mb-3">
						Concepts of a Single Identity
					</h2>
					<p class="text-base text-white/45 leading-relaxed max-w-2xl mb-4">
						Internal geometry and dynamics of one identity: form, substance, warp, and stability.
					</p>
				</div>

				{
					single.map((c, i) => {
						const reverse = i % 2 === 1;
						return (
							<a
								href={c.href}
								class="group block max-w-6xl mx-auto px-8 py-12 md:py-16 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/30 rounded-sm"
								data-concept-section
							><div class="grid md:grid-cols-2 gap-10 md:gap-14 items-center">
									<div class:list={[reverse && 'order-1 md:order-2']}>
										<div class="text-sm uppercase tracking-[4px] text-white/35 mb-3">{c.tag}</div>
										<h3 class="text-2xl md:text-3xl font-bold tracking-tight mb-4 text-white group-hover:text-white/85 transition">
											{c.title}
											<span class="ml-2 inline-block text-white/30 transition group-hover:translate-x-1 group-hover:text-white/60">→</span>
										</h3>
										<p class="text-base text-white/55 leading-relaxed mb-4">{c.blurb}</p>
										<p class="text-sm text-white/40 leading-relaxed mb-5">{c.scrollHint}</p>
										<span class="text-sm text-white/50 group-hover:text-white transition border-b border-white/20 group-hover:border-white/50 pb-0.5">
											Open concept
										</span>
									</div>
									<div
										class:list={[
											'relative h-[240px] md:h-[300px] rounded-2xl overflow-hidden border border-white/10 bg-[#0a0a0f] transition group-hover:border-white/25',
											reverse && 'order-2 md:order-1',
										]}
									>
										<ConceptSceneMount scene={c.scene} />
									</div>
								</div></a>
						);
					})
				}
			</section>

			<section id="interactive" class="border-t border-white/10">
				<div class="max-w-6xl mx-auto px-8 pt-20 pb-8">
					<div class="text-sm uppercase tracking-[4px] text-white/40 mb-3">02 · Physics</div>
					<h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white mb-3">
						Concepts of an Interactive Identity
					</h2>
					<p class="text-base text-white/45 leading-relaxed max-w-2xl">
						Once a single geometry is strong enough, forces appear between identities.
					</p>
				</div>

				{
					interactive.map((c, i) => {
						const reverse = i % 2 === 1;
						return (
							<a
								href={c.href}
								class="group block max-w-6xl mx-auto px-8 py-12 md:py-16 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/30 rounded-sm"
								data-concept-section
							><div class="grid md:grid-cols-2 gap-10 md:gap-14 items-center">
									<div class:list={[reverse && 'order-1 md:order-2']}>
										<div class="text-sm uppercase tracking-[4px] text-white/35 mb-3">{c.tag}</div>
										<h3 class="text-2xl md:text-3xl font-bold tracking-tight mb-4 text-white group-hover:text-white/85 transition">
											{c.title}
											<span class="ml-2 inline-block text-white/30 transition group-hover:translate-x-1 group-hover:text-white/60">→</span>
										</h3>
										<p class="text-base text-white/55 leading-relaxed mb-4">{c.blurb}</p>
										<p class="text-sm text-white/40 leading-relaxed mb-5">{c.scrollHint}</p>
										<span class="text-sm text-white/50 group-hover:text-white transition border-b border-white/20 group-hover:border-white/50 pb-0.5">
											Open concept
										</span>
									</div>
									<div
										class:list={[
											'relative h-[240px] md:h-[300px] rounded-2xl overflow-hidden border border-white/10 bg-[#0a0a0f] transition group-hover:border-white/25',
											reverse && 'order-2 md:order-1',
										]}
									>
										<ConceptSceneMount scene={c.scene} />
									</div>
								</div></a>
						);
					})
				}
			</section>

			<section id="collective" class="border-t border-white/10">
				<div class="max-w-6xl mx-auto px-8 pt-20 pb-8">
					<div class="text-sm uppercase tracking-[4px] text-white/40 mb-3">03 · Physics</div>
					<h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white mb-3">
						Concepts of a Collective Identity
					</h2>
					<p class="text-base text-white/45 leading-relaxed max-w-2xl">
						When identities stay coupled long enough, a higher-order identity emerges with its own persistence and damping.
					</p>
				</div>

				{
					collective.map((c, i) => {
						const reverse = i % 2 === 1;
						return (
							<a
								href={c.href}
								class="group block max-w-6xl mx-auto px-8 py-12 md:py-16 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/30 rounded-sm"
								data-concept-section
							><div class="grid md:grid-cols-2 gap-10 md:gap-14 items-center">
									<div class:list={[reverse && 'order-1 md:order-2']}>
										<div class="text-sm uppercase tracking-[4px] text-white/35 mb-3">{c.tag}</div>
										<h3 class="text-2xl md:text-3xl font-bold tracking-tight mb-4 text-white group-hover:text-white/85 transition">
											{c.title}
											<span class="ml-2 inline-block text-white/30 transition group-hover:translate-x-1 group-hover:text-white/60">→</span>
										</h3>
										<p class="text-base text-white/55 leading-relaxed mb-4">{c.blurb}</p>
										<p class="text-sm text-white/40 leading-relaxed mb-5">{c.scrollHint}</p>
										<span class="text-sm text-white/50 group-hover:text-white transition border-b border-white/20 group-hover:border-white/50 pb-0.5">
											Open concept
										</span>
									</div>
									<div
										class:list={[
											'relative h-[240px] md:h-[300px] rounded-2xl overflow-hidden border border-white/10 bg-[#0a0a0f] transition group-hover:border-white/25',
											reverse && 'order-2 md:order-1',
										]}
									>
										<ConceptSceneMount scene={c.scene} />
									</div>
								</div></a>
						);
					})
				}
			</section>
		</div>

		{/* ========== BIOLOGY LENS ========== */}
		<div id="lens-panel-biology" role="tabpanel" aria-labelledby="lens-biology" aria-hidden="true" tabindex="-1" data-lens-panel="biology" class="hidden">
			<section id="biology-single" class="border-t border-white/10">
				<div class="max-w-6xl mx-auto px-8 pt-20 pb-8">
					<div class="text-sm uppercase tracking-[4px] text-white/40 mb-3">01 · Biology</div>
					<h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white mb-3">
						Single Identity as living form
					</h2>
					<p class="text-base text-white/45 leading-relaxed max-w-2xl mb-4">
						Gene → Boundary → Cell → Metabolism. Founding core, membrane, living unit, and its process.
					</p>
				</div>

				{
					bioSingle.map((c, i) => {
						const reverse = i % 2 === 1;
						return (
							<a
								href={c.href}
								class="group block max-w-6xl mx-auto px-8 py-12 md:py-16 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/30 rounded-sm"
								data-concept-section
							>
								<div class="grid md:grid-cols-2 gap-10 md:gap-14 items-center">
									<div class:list={[reverse && 'order-1 md:order-2']}>
										<div class="text-sm uppercase tracking-[4px] text-white/35 mb-3">{c.tag}</div>
										<h3 class="text-2xl md:text-3xl font-bold tracking-tight mb-4 text-white group-hover:text-white/85 transition">
											{c.title}
											<span class="ml-2 inline-block text-white/30 transition group-hover:translate-x-1 group-hover:text-white/60">→</span>
										</h3>
										<p class="text-base text-white/55 leading-relaxed mb-5">{c.blurb}</p>
										<span class="text-sm text-white/50 group-hover:text-white transition border-b border-white/20 group-hover:border-white/50 pb-0.5">
											Open concept
										</span>
									</div>
									<div
										class:list={[
											'relative h-[240px] md:h-[300px] rounded-2xl overflow-hidden border border-white/10 bg-[#0a0a0f] transition group-hover:border-white/25 flex items-center justify-center',
											reverse && 'order-2 md:order-1',
										]}
									>
										<div class="text-center px-8">
											<div class="text-sm uppercase tracking-[4px] text-white/30 mb-3">Biology lens</div>
											<div class="text-2xl md:text-3xl font-bold text-white/80 tracking-tight">{c.title}</div>
											<p class="mt-3 text-sm text-white/40 max-w-xs mx-auto leading-relaxed">{c.tag}</p>
										</div>
									</div>
								</div>
							</a>
						);
					})
				}
			</section>

			<section id="biology-interactive" class="border-t border-white/10">
				<div class="max-w-6xl mx-auto px-8 pt-20 pb-8">
					<div class="text-sm uppercase tracking-[4px] text-white/40 mb-3">02 · Biology</div>
					<h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white mb-3">
						Interactive Identity as living form
					</h2>
					<p class="text-base text-white/45 leading-relaxed max-w-2xl mb-4">
						Signal → Recognition → Coupling. Exchange, discrimination, sustained link.
					</p>
				</div>

				{
					bioInteractive.map((c, i) => {
						const reverse = i % 2 === 1;
						return (
							<a
								href={c.href}
								class="group block max-w-6xl mx-auto px-8 py-12 md:py-16 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/30 rounded-sm"
								data-concept-section
							>
								<div class="grid md:grid-cols-2 gap-10 md:gap-14 items-center">
									<div class:list={[reverse && 'order-1 md:order-2']}>
										<div class="text-sm uppercase tracking-[4px] text-white/35 mb-3">{c.tag}</div>
										<h3 class="text-2xl md:text-3xl font-bold tracking-tight mb-4 text-white group-hover:text-white/85 transition">
											{c.title}
											<span class="ml-2 inline-block text-white/30 transition group-hover:translate-x-1 group-hover:text-white/60">→</span>
										</h3>
										<p class="text-base text-white/55 leading-relaxed mb-5">{c.blurb}</p>
										<span class="text-sm text-white/50 group-hover:text-white transition border-b border-white/20 group-hover:border-white/50 pb-0.5">
											Open concept
										</span>
									</div>
									<div
										class:list={[
											'relative h-[240px] md:h-[300px] rounded-2xl overflow-hidden border border-white/10 bg-[#0a0a0f] transition group-hover:border-white/25 flex items-center justify-center',
											reverse && 'order-2 md:order-1',
										]}
									>
										<div class="text-center px-8">
											<div class="text-sm uppercase tracking-[4px] text-white/30 mb-3">Biology lens</div>
											<div class="text-2xl md:text-3xl font-bold text-white/80 tracking-tight">{c.title}</div>
											<p class="mt-3 text-sm text-white/40 max-w-xs mx-auto leading-relaxed">{c.tag}</p>
										</div>
									</div>
								</div>
							</a>
						);
					})
				}
			</section>

			<section id="biology-collective" class="border-t border-white/10">
				<div class="max-w-6xl mx-auto px-8 pt-20 pb-8">
					<div class="text-sm uppercase tracking-[4px] text-white/40 mb-3">03 · Biology</div>
					<h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white mb-3">
						Collective Identity as living form
					</h2>
					<p class="text-base text-white/45 leading-relaxed max-w-2xl mb-4">
						Multicellularity → Specialization → Regulation. Higher-order form, roles, multi-speed control.
					</p>
				</div>

				{
					bioCollective.map((c, i) => {
						const reverse = i % 2 === 1;
						return (
							<a
								href={c.href}
								class="group block max-w-6xl mx-auto px-8 py-12 md:py-16 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/30 rounded-sm"
								data-concept-section
							>
								<div class="grid md:grid-cols-2 gap-10 md:gap-14 items-center">
									<div class:list={[reverse && 'order-1 md:order-2']}>
										<div class="text-sm uppercase tracking-[4px] text-white/35 mb-3">{c.tag}</div>
										<h3 class="text-2xl md:text-3xl font-bold tracking-tight mb-4 text-white group-hover:text-white/85 transition">
											{c.title}
											<span class="ml-2 inline-block text-white/30 transition group-hover:translate-x-1 group-hover:text-white/60">→</span>
										</h3>
										<p class="text-base text-white/55 leading-relaxed mb-5">{c.blurb}</p>
										<span class="text-sm text-white/50 group-hover:text-white transition border-b border-white/20 group-hover:border-white/50 pb-0.5">
											Open concept
										</span>
									</div>
									<div
										class:list={[
											'relative h-[240px] md:h-[300px] rounded-2xl overflow-hidden border border-white/10 bg-[#0a0a0f] transition group-hover:border-white/25 flex items-center justify-center',
											reverse && 'order-2 md:order-1',
										]}
									>
										<div class="text-center px-8">
											<div class="text-sm uppercase tracking-[4px] text-white/30 mb-3">Biology lens</div>
											<div class="text-2xl md:text-3xl font-bold text-white/80 tracking-tight">{c.title}</div>
											<p class="mt-3 text-sm text-white/40 max-w-xs mx-auto leading-relaxed">{c.tag}</p>
										</div>
									</div>
								</div>
							</a>
						);
					})
				}
			</section>
		</div>

		{/* Living Identity — shared operational scaffold */}
		<section id="living" class="border-t border-white/10">
			<div class="max-w-6xl mx-auto px-8 pt-20 pb-8">
				<div class="text-sm uppercase tracking-[4px] text-white/40 mb-3">Operational</div>
				<h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white mb-3">
					Living Identity
				</h2>
				<p class="text-base text-white/45 leading-relaxed max-w-2xl mb-4">
					Scaffold under both lenses: how geometry is metabolized through Interaction.
					Hub for the biology map and the relation to OS.
				</p>
			</div>

			<a
				href="/framework/living-identity"
				class="group block max-w-6xl mx-auto px-8 py-12 md:py-16 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/30 rounded-sm"
				data-concept-section
			>
				<div class="grid md:grid-cols-2 gap-10 md:gap-14 items-center">
					<div>
						<div class="text-sm uppercase tracking-[4px] text-white/35 mb-3">Hub</div>
						<h3 class="text-2xl md:text-3xl font-bold tracking-tight mb-4 text-white group-hover:text-white/85 transition">
							Biology map · Life criteria · OS link
							<span class="ml-2 inline-block text-white/30 transition group-hover:translate-x-1 group-hover:text-white/60">→</span>
						</h3>
						<p class="text-base text-white/55 leading-relaxed mb-4">
							Life as IE criteria (boundary, metabolism, continuity, causal entropy under constraint).
							Full index of biology-lens concepts and honesty labels.
						</p>
						<span class="text-sm text-white/50 group-hover:text-white transition border-b border-white/20 group-hover:border-white/50 pb-0.5">
							Open Living Identity
						</span>
					</div>
					<div class="relative h-[240px] md:h-[300px] rounded-2xl overflow-hidden border border-white/10 bg-[#0a0a0f] transition group-hover:border-white/25 flex items-center justify-center">
						<div class="text-center px-8">
							<div class="text-sm uppercase tracking-[4px] text-white/30 mb-3">Scaffold</div>
							<div class="text-2xl md:text-3xl font-bold text-white/80 tracking-tight">Living form</div>
							<p class="mt-3 text-sm text-white/40 max-w-xs mx-auto leading-relaxed">
								Geometry metabolized through Interaction
							</p>
						</div>
					</div>
				</div>
			</a>
		</section>

		<section class="py-20 border-t border-white/10">
			<div class="max-w-3xl mx-auto px-8 text-center">
				<h2 class="text-3xl font-bold tracking-tight mb-4 text-white">Where the map ends</h2>
				<p class="text-lg text-white/50 mb-10 max-w-xl mx-auto">
					Human-scale identity is the foundation. Frontier domains remain open on purpose.
				</p>
				<div class="flex flex-wrap gap-4 justify-center">
					<a href="/big-questions" class="px-8 py-3.5 rounded-full bg-white text-black font-medium hover:bg-white/90 transition">Big Questions</a>
					<a href="/framework/time" class="px-8 py-3.5 rounded-full border border-white/20 text-white/70 hover:bg-white/5 transition">Start with Time</a>
					<a href="/framework/gene" class="px-8 py-3.5 rounded-full border border-white/20 text-white/70 hover:bg-white/5 transition">Start with Gene</a>
					<a href="/framework/living-identity" class="px-8 py-3.5 rounded-full border border-white/20 text-white/70 hover:bg-white/5 transition">Living Identity</a>
				</div>
			</div>
		</section>
	</main>

	<script>
		function setLens(lens: string) {
			const physics = document.getElementById('lens-panel-physics');
			const biology = document.getElementById('lens-panel-biology');
			const btns = document.querySelectorAll('.lens-btn');

			if (physics && biology) {
				physics.classList.toggle('hidden', lens !== 'physics');
				biology.classList.toggle('hidden', lens !== 'biology');
				physics.setAttribute('aria-hidden', lens === 'physics' ? 'false' : 'true');
				biology.setAttribute('aria-hidden', lens === 'biology' ? 'false' : 'true');
				physics.setAttribute('tabindex', lens === 'physics' ? '0' : '-1');
				biology.setAttribute('tabindex', lens === 'biology' ? '0' : '-1');
			}

			btns.forEach((btn) => {
				const active = btn.getAttribute('data-lens') === lens;
				btn.setAttribute('aria-selected', active ? 'true' : 'false');
				if (active) {
					btn.classList.add('bg-white', 'text-black');
					btn.classList.remove('border', 'border-white/20', 'text-white/70');
				} else {
					btn.classList.remove('bg-white', 'text-black');
					btn.classList.add('border', 'border-white/20', 'text-white/70');
				}
			});

			try {
				localStorage.setItem('ie-framework-lens', lens);
			} catch {
				/* ignore */
			}
		}

		document.querySelectorAll('.lens-btn').forEach((btn) => {
			btn.addEventListener('click', () => {
				const lens = btn.getAttribute('data-lens');
				if (lens) setLens(lens);
			});
		});

		try {
			const saved = localStorage.getItem('ie-framework-lens');
			if (saved === 'biology' || saved === 'physics') setLens(saved);
		} catch {
			/* ignore */
		}
	</script>
</Layout>
