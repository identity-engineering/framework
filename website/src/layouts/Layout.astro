---
/**
 * Site chrome: header, page slot, automatic per-page GapsSection, footer.
 * Gaps resolve via GitHub page:* labels from the current path (see lib/gaps.ts).
 */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GapsSection from '../components/GapsSection.astro';
import { resolveGapsPageSlugs } from '../lib/gaps';

interface Props {
	title: string;
	/**
	 * Per-page gaps control:
	 * - omit: auto from URL → page:* labels
	 * - string | string[]: force those slugs
	 * - false: hide GapsSection (rare; /critical-gaps auto-hides)
	 */
	gaps?: string | string[] | false;
}

const { title, gaps } = Astro.props;

const gapsSlugs: string[] | null = (() => {
	if (gaps === false) return null;
	if (gaps !== undefined) return Array.isArray(gaps) ? gaps : [gaps];
	return resolveGapsPageSlugs(Astro.url.pathname);
})();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Identity Engineering: a science-grounded framework for consciously shaping human identities in the AI era." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen flex flex-col">
		<Header />
		<div class="flex-1">
			<slot />
			{gapsSlugs && gapsSlugs.length > 0 && <GapsSection page={gapsSlugs} />}
		</div>
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--success: 16, 185, 129;
	}

	html {
		font-family: system-ui, sans-serif;
		background: #0a0a0f;
		color: #ededed;
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
	}
</style>
