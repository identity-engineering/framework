---
/**
 * Specialization (Economics) — Economics-lens concept at Collective scale.
 * Distinct roles under competition and exchange that raise collective capacity.
 * Distinct from Biology-lens Specialization; same name, different lens reading.
 * Keep inline tags on one line with outer spaces (Astro whitespace).
 * No em-dashes in public copy.
 */
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Specialization (Economics) | Identity Engineering">
	<main class="min-h-screen">
		<section class="min-h-[50vh] flex flex-col justify-center pt-28 pb-16 border-b border-white/10">
			<div class="max-w-3xl mx-auto px-8">
				<div class="text-sm uppercase tracking-[4px] text-white/40 mb-6">
					Economics lens · Collective Identity
				</div>
				<h1 class="text-4xl md:text-6xl font-bold tracking-tighter leading-[0.95] mb-6 text-white">
					Specialization
				</h1>
				<p class="text-xl text-white/50 font-light leading-relaxed mb-6">
					Under competition and exchange, Identities take distinct roles that raise collective capacity
					without erasing member Ownership.
				</p>
				<div class="rounded-2xl border border-amber-500/20 bg-amber-500/[0.04] p-4">
					<p class="text-sm text-white/65 leading-relaxed">
						<strong class="text-white/80">Status:</strong> Core concept under the Economics lens.
						Parallel reading to Biology Specialization. Analogy, not isomorphism.
					</p>
				</div>
			</div>
		</section>

		<section class="px-8 py-16 border-b border-white/10">
			<div class="max-w-3xl mx-auto space-y-6 text-white/60 leading-relaxed">
				<div class="text-sm uppercase tracking-[4px] text-white/40">Definition</div>
				<h2 class="text-3xl font-bold tracking-tight text-white">Division of labor under pressure.</h2>
				<p>
					<strong class="text-white/85">Specialization</strong> (Economics) emerges when Competition and the possibility of Exchange make it rational for Identities to concentrate on domains of relative advantage.
					Member Ownership and Boundary remain intact; the collective gains capacity no uniform set of Identities could sustain.
				</p>
				<p>
					See also the Biology-lens reading of Specialization (role differentiation inside Multicellularity).
				</p>
			</div>
		</section>

		<section class="px-8 py-16">
			<div class="max-w-3xl mx-auto space-y-6 text-white/55 leading-relaxed">
				<div class="flex flex-wrap gap-4 pt-4">
					<a href="/framework/competition" class="px-6 py-3 rounded-full border border-white/20 text-white/70 hover:bg-white/5 transition">Competition</a>
					<a href="/framework/specialization" class="px-6 py-3 rounded-full border border-white/20 text-white/70 hover:bg-white/5 transition">Specialization (Biology)</a>
					<a href="/framework" class="px-6 py-3 rounded-full bg-white text-black font-medium hover:bg-white/90 transition">Framework</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
